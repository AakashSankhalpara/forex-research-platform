
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forex-research-platform",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "MARKET_DATA",
      "bucket_name": "forex-market-data"
    }
  ]
}
